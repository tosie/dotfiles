#!/usr/bin/env bash
# Set fish as the login shell. Invoked by [bootstrap.hooks].final.
# Safe to repeat.
set -euo pipefail

if [ "${1:-}" = "--dry-run" ]; then
  echo "Would set fish as the login shell."
  exit 0
fi

if [ "${OS:-}" = "Windows_NT" ]; then
  echo "Windows has no login shell to switch. Set fish as the Windows Terminal profile."
  exit 0
fi

find_fish() {
  local candidate prefix
  if command -v fish >/dev/null 2>&1; then
    command -v fish
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    prefix="$(brew --prefix)"
    candidate="$prefix/bin/fish"
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /usr/bin/fish /bin/fish; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

fish_bin="$(find_fish)" || {
  echo "fish is not installed, so the login shell was not changed." >&2
  exit 1
}

current=""
case "$(uname -s)" in
  Darwin)
    current="$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '/UserShell:/ { print $2 }')"
    ;;
  *)
    if command -v getent >/dev/null 2>&1; then
      current="$(getent passwd "$USER" | awk -F: '{ print $NF }')"
    elif [ -r /etc/passwd ]; then
      current="$(awk -F: -v user="$USER" '$1 == user { print $NF }' /etc/passwd)"
    fi
    ;;
esac

# chsh stores one path, and a later lookup may be a symlink to that same fish.
# A second bootstrap must not ask for a password again.
if [ -n "$current" ] && { [ "$current" = "$fish_bin" ] || [ "$current" -ef "$fish_bin" ] || [ "$(basename "$current")" = "fish" ]; }; then
  echo "Login shell is already fish ($current)."
  exit 0
fi

# Prefer a path already approved in /etc/shells so a repeat run does not append.
shell_path="$fish_bin"
if [ -r /etc/shells ]; then
  while IFS= read -r listed || [ -n "$listed" ]; do
    case "$listed" in
      '' | \#*) continue ;;
    esac
    if [ "$listed" = "$fish_bin" ] || [ "$listed" -ef "$fish_bin" ]; then
      shell_path="$listed"
      break
    fi
  done < /etc/shells
fi

if [ ! -r /etc/shells ] || ! grep -qxF "$shell_path" /etc/shells; then
  echo "Adding $shell_path to /etc/shells."
  printf '%s\n' "$shell_path" | sudo tee -a /etc/shells >/dev/null
fi

chsh -s "$shell_path"
echo "Login shell set to $shell_path. Open a new terminal to use it."
